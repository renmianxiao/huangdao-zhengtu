static func leader(id: String) -> Dictionary:
	for entry: Dictionary in LEADERS:
		if entry.id == id: return entry.duplicate(true)
	return {}

static func is_attack_skill(id: String) -> bool:
	var skill: Dictionary = SKILLS.get(id, {})
	if skill.has("damage"): return true
	for operation: Dictionary in skill.get("effects", []):
		if operation.get("op", "") in ["damage", "multi_damage"]: return true
	return false

